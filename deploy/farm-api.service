[Unit]
Description=Farm API (FastAPI gunicorn)
After=network.target

[Service]
WorkingDirectory=/opt/farm
Environment=PATH=/opt/farm/api/venv/bin
Environment=PYTHONPATH=/opt/farm/api
ExecStart=/opt/farm/api/venv/bin/gunicorn \
    -w 2 \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8003 \
    --access-logfile /var/log/farm/api-access.log \
    --error-logfile /var/log/farm/api-error.log \
    --timeout 120 \
    api.main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
